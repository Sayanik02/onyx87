{
  "installCommand": "cd \"dash idea new\" && npm install",
  "buildCommand": "cd \"dash idea new\" && npm run build",
  "outputDirectory": "dash idea new/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
